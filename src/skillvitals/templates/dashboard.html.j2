<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>skillvitals dashboard</title>
<style>
  :root { --bg:#0d1117; --card:#161b22; --line:#30363d; --fg:#e6edf3; --dim:#8b949e;
          --green:#3fb950; --yellow:#d29922; --red:#f85149; --accent:#58a6ff; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--fg);
         font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
  .wrap { max-width: 1100px; margin: 0 auto; padding: 32px 20px 64px; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  .sub { color: var(--dim); margin: 0 0 24px; }
  .cards { display:flex; gap:14px; flex-wrap:wrap; margin-bottom:28px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:10px;
          padding:16px 18px; min-width:150px; flex:1; }
  .card .n { font-size:26px; font-weight:700; }
  .card .l { color:var(--dim); font-size:12px; text-transform:uppercase; letter-spacing:.04em; }
  .card.alert .n { color: var(--yellow); }
  table { width:100%; border-collapse:collapse; background:var(--card);
          border:1px solid var(--line); border-radius:10px; overflow:hidden; }
  th,td { text-align:left; padding:10px 14px; border-bottom:1px solid var(--line); }
  th { cursor:pointer; user-select:none; color:var(--dim); font-weight:600;
       font-size:12px; text-transform:uppercase; letter-spacing:.03em; }
  th:hover { color: var(--fg); }
  tbody tr:last-child td { border-bottom:none; }
  tbody tr:hover { background: #1c2330; }
  td.num { text-align:right; font-variant-numeric: tabular-nums; }
  .pill { display:inline-block; padding:2px 8px; border-radius:999px; font-size:12px; font-weight:600; }
  .healthy { color:var(--green); } .dormant,.misfiring { color:var(--yellow); }
  .never-fired { color:var(--dim); } .orphan,.disabled { color:var(--red); }
  .bar { height:6px; background:#21262d; border-radius:4px; overflow:hidden; min-width:60px; }
  .bar > i { display:block; height:100%; background:var(--accent); }
  .rx { margin-top:28px; }
  .rx h2 { font-size:16px; }
  .rx li { margin:6px 0; color:var(--dim); }
  .rx b { color:var(--fg); }
  footer { margin-top:30px; color:var(--dim); font-size:12px; }
  code { background:#21262d; padding:1px 6px; border-radius:5px; }
</style>
</head>
<body>
<div class="wrap">
  <h1>skillvitals</h1>
  <p class="sub">{{ total }} skills scanned · generated {{ generated_at }}</p>

  <div class="cards">
    <div class="card"><div class="n">{{ total }}</div><div class="l">skills</div></div>
    <div class="card"><div class="n">{{ healthy }}</div><div class="l">healthy</div></div>
    <div class="card alert"><div class="n">{{ dormant_count }}</div><div class="l">dormant / never-fired</div></div>
    <div class="card alert"><div class="n">{{ dormant_cost_h }}</div><div class="l">always-loaded tokens / session</div></div>
  </div>

  <table id="vitals">
    <thead><tr>
      <th onclick="sortTable(0,'s')">skill</th>
      <th onclick="sortTable(1,'n')">fires</th>
      <th onclick="sortTable(2,'n')">engaged</th>
      <th onclick="sortTable(3,'n')" title="description tokens, loaded every session">always-on</th>
      <th onclick="sortTable(4,'n')" title="body tokens, loaded only when the skill activates">on-fire</th>
      <th onclick="sortTable(5,'n')">quality</th>
      <th onclick="sortTable(6,'n')">last seen</th>
      <th onclick="sortTable(7,'s')">status</th>
    </tr></thead>
    <tbody>
    {% for r in rows %}
      <tr class="skill-row">
        <td>{{ r.name }}</td>
        <td class="num" data-v="{{ r.fires }}">{{ r.fires }}</td>
        <td class="num" data-v="{{ r.engaged }}">{{ r.engaged }}</td>
        <td class="num" data-v="{{ r.always_on }}">{{ r.always_on_h }}</td>
        <td class="num" data-v="{{ r.on_fire }}">{{ r.on_fire_h }}</td>
        <td class="num" data-v="{{ r.quality }}">
          <div class="bar" title="{{ r.quality }}/100"><i style="width:{{ r.quality }}%"></i></div>
        </td>
        <td class="num" data-v="{{ r.age_v }}">{{ r.last_seen }}</td>
        <td><span class="pill {{ r.status_class }}">{{ r.status_label }}</span></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  {% if prescriptions %}
  <div class="rx">
    <h2>Prescriptions ({{ prescriptions|length }})</h2>
    <ul>
      {% for p in prescriptions %}
        <li>[{{ p.severity }}] <b>{{ p.skill_name }}</b>: {{ p.message }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  <footer>
    skillvitals · local-only · reads <code>~/.claude</code> · no data leaves your machine
  </footer>
</div>
<script>
function sortTable(col, type){
  var tb=document.querySelector('#vitals tbody');
  var rows=Array.prototype.slice.call(tb.querySelectorAll('tr'));
  var asc = tb.getAttribute('data-col')==col && tb.getAttribute('data-dir')!='asc';
  rows.sort(function(a,b){
    var x=a.children[col], y=b.children[col];
    if(type=='n'){ x=parseFloat(x.getAttribute('data-v')||0); y=parseFloat(y.getAttribute('data-v')||0); return asc?x-y:y-x; }
    x=x.textContent.trim(); y=y.textContent.trim(); return asc?x.localeCompare(y):y.localeCompare(x);
  });
  rows.forEach(function(r){ tb.appendChild(r); });
  tb.setAttribute('data-col',col); tb.setAttribute('data-dir',asc?'asc':'desc');
}
</script>
</body>
</html>
